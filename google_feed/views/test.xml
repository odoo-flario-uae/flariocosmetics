<odoo>
    <record id="res_config_settings_view_form_inherit_website" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.feed</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_info_settings']" position="after">
                <div class="app_settings_block" data-string="Google Feed" string="Google Feed" data-key="google_feed">
                    <h2>Google Feed Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="google_feed_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="google_feed_enabled"/>
                                <div class="text-muted">Enable Google Feed</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                                <label for="google_feed_location_id"/>
                                <div class="text-muted">Select Warehouse Location</div>
                                <field name="google_feed_location_id"/>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                                <label for="google_feed_root_category_id"/>
                                <div class="text-muted">Select Root Category</div>
                                <field name="google_feed_root_category_id"/>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="google_feed_url" string="Google Feed URL"/>
                                <div class="text-muted">
                                    <field name="google_feed_url" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
